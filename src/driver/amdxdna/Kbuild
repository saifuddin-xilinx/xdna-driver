# AMD XDNA HAL prototype - standalone module, no dependency on amdxdna.
#

ROOT := $(src)
ccflags-y += -I$(ROOT)
# uAPI
ccflags-y += -I$(ROOT)/../../include/uapi
# version.h
ccflags-y += -I$(ROOT)/../../include

# Optional: use project's config_kernel.h when building via xdna-driver CMake
-include $(ROOT)/config_kernel.h

# Enable development features for prototype
ccflags-y += -DAMDXDNA_DEVEL

obj-m	+= amdxdna.o
amdxdna-y := amdxdna_hal_drv.o \
		amdxdna_drm.o \
		amdxdna_gem.o \
		amdxdna_ctx.o \
		amdxdna_dpt.o \
		amdxdna_pm.o \
		amdxdna_iommu.o \
		amdxdna_mgmt.o \
		amdxdna_carvedout_buf.o \
		amdxdna_ubuf.o \
		amdxdna_cma_buf.o \
		amdxdna_devel.o

amdxdna-$(OFT_CONFIG_AMDXDNA_PCI) += \
		amdxdna_pci_drv.o \
		aie2_pci.o \
		aie4_pci.o

amdxdna-$(OFT_CONFIG_AMDXDNA_AUX) += \
		amdxdna_aux_drv.o \
		ve2_aux.o
